; Engine configuration file.
; Generated by FTG Framework — scaffolded by `ftg new`.

config_version=5

[application]

config/name="{{FTG_PROJECT_NAME}}"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

FrameRateManager="*res://Scripts/FrameRateManager.cs"
GameLoop="*res://Scripts/Framework/Core/GameLoop.cs"

[dotnet]

project/assembly_name="{{FTG_PROJECT_NAME}}"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="disabled"

[ftg]

test_harness/enabled=true
training/ui_scale=1.0

[editor_plugins]

enabled=PackedStringArray("res://addons/ftg-framework/plugin.cfg")

