; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FTG_Framework"
run/main_scene="res://node_2d.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

FrameRateManager="*res://Scripts/FrameRateManager.cs"
GameLoop="*res://Scripts/Framework/Core/GameLoop.cs"

[dotnet]

project/assembly_name="FTG_Framework"

[editor_plugins]

enabled=PackedStringArray("res://addons/ftg-framework/plugin.cfg", "res://addons/rider-plugin/plugin.cfg")

[ftg]

test_harness/enabled=true

